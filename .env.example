# ── ANSA Designer Lounge Environment Template ─────────────────────────────────
# Copy this file to .env.local and fill in your private values.

# Admin Credentials
ADMIN_USERNAME=admin@ansadesigner.cloud
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_NAME="Store Administrator"

# JWT Encryption Secret (Use a strong 64+ char random string)
JWT_SECRET=your_super_secret_jwt_random_key_here

# Site Domain
NEXT_PUBLIC_SITE_URL=https://www.ansadesigner.cloud

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
